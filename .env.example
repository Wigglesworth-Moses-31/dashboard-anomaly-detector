# scripts/setup.sh writes .env for you (it asks for the keys and generates the password).
# To write it by hand instead: copy this file to .env and fill in your own values. Never share or commit .env.
#
# Two keys per Datadog account (source), named after the source in config-repo/collector.yml:
#   API key:          Organization settings → API keys
#   Application key:  Organization settings → Application keys, scopes dashboards_read, timeseries_query, metrics_read
DD_US_API_KEY=
DD_US_APP_KEY=
# A second region, if you watch one (a source named "eu" on datadoghq.eu):
# DD_EU_API_KEY=
# DD_EU_APP_KEY=
#
# Local database password (any long random string)
PLATFORM_DB_PASSWORD=
